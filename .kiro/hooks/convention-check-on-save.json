{
  "version": "v1",
  "hooks": [
    {
      "name": "Convention check on save",
      "trigger": "PostFileSave",
      "description": "에이전트가 백엔드 Java 파일을 저장·수정하면 코드 컨벤션(C1~C10) 검사를 실행한다.",
      "matcher": "src/main/.*\\.java$",
      "action": {
        "type": "command",
        "command": "bash scripts/check-conventions.sh",
        "timeout": 30
      }
    }
  ]
}